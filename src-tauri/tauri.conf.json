{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.powerinterviewai.client-app",
  "productName": "Power Interview AI",
  "version": "0.1.2",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Power Interview AI",
        "width": 1024,
        "height": 640,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "VectorLeap Pulse Innovation LTD",
    "copyright": "Copyright ©2026 VectorLeap Pulse Innovation LTD",
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.mac.plist",
      "minimumSystemVersion": "14.4",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2ODdBMTNBREYwNkYxNUMKUldSYzhRYmZPcUdIRmwzTzBWZ1VlaVl2bnBqMmxmUENpUEh5UkJFWlFENklObTR2ZjNPeWc0akIK",
      "endpoints": [
        "https://github.com/PowerInterviewAI/client-app-tauri/releases/latest/download/latest.json"
      ]
    }
  }
}
